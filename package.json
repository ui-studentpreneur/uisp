{
  "name": "uisp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm lint",
    "db:push": "tsx --env-file=.env.local node_modules/drizzle-kit/bin.cjs push",
    "db:generate": "tsx --env-file=.env.local node_modules/drizzle-kit/bin.cjs generate",
    "db:studio": "tsx --env-file=.env.local node_modules/drizzle-kit/bin.cjs studio",
    "db:seed": "tsx --conditions=react-server --env-file=.env.local scripts/seed.ts",
    "admin:create": "tsx --conditions=react-server --env-file=.env.local scripts/create-admin.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@gsap/react": "^2.1.2",
    "better-auth": "^1.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "gsap": "^3.15.0",
    "lucide-react": "^1.33.0",
    "next": "16.3.2",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-player": "^3.4.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.7.1"
}
