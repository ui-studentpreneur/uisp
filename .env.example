# Copy to `.env.local` and fill in. Every variable is read only in src/config/env.ts.

# Absolute origin used for metadata, canonical URLs and OG images.
# Must be a full absolute URL, or left out entirely — a variable that exists
# but is blank is treated as unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# debug | info | warn | error
LOG_LEVEL=debug

# --- Database -----------------------------------------------------------
# PostgreSQL connection string. Drizzle reads it directly; `pnpm db:push`
# and `pnpm db:seed` fail loudly without it.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# --- Auth ---------------------------------------------------------------
# Signing key for Better Auth sessions. Generate one per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# Absolute origin Better Auth issues callbacks against.
BETTER_AUTH_URL=http://localhost:3000

# --- Admin bootstrap ----------------------------------------------------
# Read only by `pnpm db:seed`, which creates the single admin account. Change
# the password before running it anywhere real.
ADMIN_EMAIL=admin@uisp.local
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=UISP Admin
