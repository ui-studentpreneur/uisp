# Copy to `.env.local` and fill in. Every variable is read only in src/config/env.ts.

# Absolute origin used for metadata, canonical URLs and OG images.
# Must be a full absolute URL, or left out entirely — a variable that exists
# but is blank is treated as unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# debug | info | warn | error
LOG_LEVEL=debug

# --- Database -----------------------------------------------------------
# PostgreSQL connection string. Drizzle reads it directly; `pnpm db:push`
# and `pnpm db:seed` fail loudly without it.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# --- Auth ---------------------------------------------------------------
# Signing key for Better Auth sessions. Generate one per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# Absolute origin Better Auth issues callbacks against.
BETTER_AUTH_URL=http://localhost:3000

# --- Object storage (Cloudflare R2) --------------------------------------
# Images uploaded from /admin. Without these the site still builds and every
# image under public/ still renders — only uploading needs them.
#   1. Create a bucket, then an R2 API token with Object Read & Write.
#   2. Allow PUT from your site's origin in the bucket's CORS policy, or the
#      browser's upload is blocked before it starts.
#   3. Expose the bucket publicly (r2.dev subdomain or a custom domain) and put
#      that origin in R2_PUBLIC_URL — it is what gets saved into the content.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=uisp-content
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# --- Admin bootstrap ----------------------------------------------------
# Read only by `pnpm db:seed`, which creates the single admin account. Change
# the password before running it anywhere real.
ADMIN_EMAIL=admin@uisp.local
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=UISP Admin
